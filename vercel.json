{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd mira/frontend && npm install && npm run build",
  "outputDirectory": "mira/frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "mira/backend/{app,ml,data}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
